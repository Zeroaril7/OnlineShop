# URL Backend (Gunakan URL Render saat deployment produksi, atau kosongkan / http://localhost:5000 saat lokal)
VITE_API_URL=http://localhost:5000

# Monitoring: LogRocket App ID (Format: <org-slug>/<app-slug>, dapatkan dari https://app.logrocket.com)
VITE_LOGROCKET_APP_ID=

# Monitoring: Google Analytics Measurement ID (Format: G-XXXXXXXXXX, dapatkan dari Google Analytics 4)
VITE_GA_MEASUREMENT_ID=
